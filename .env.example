# ============================================
# Kafka Data Quality Monitor - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.

# --- Source Database ---
SOURCE_DB_HOST=postgres-source
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=source_db
SOURCE_DB_USER=source_user
SOURCE_DB_PASSWORD=change_me_source

# --- Data Warehouse ---
WAREHOUSE_DB_HOST=postgres-warehouse
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=warehouse_db
WAREHOUSE_DB_USER=warehouse_user
WAREHOUSE_DB_PASSWORD=change_me_warehouse

# --- MinIO Data Lake ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=http://minio:9000

# --- Airflow ---
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_FERNET_KEY=change_me_fernet_key_base64
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false

# --- DataHub ---
DATAHUB_MYSQL_PASSWORD=change_me_datahub
DATAHUB_SECRET=change_me_datahub_secret
DATAHUB_GMS_URL=http://datahub-gms:8080

# --- Data Access API ---
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_ALGORITHM=HS256

# --- External APIs ---
FMP_API_KEY=your_financial_modeling_prep_api_key
