# Auto detect text files and ensure LF for files that run in Linux containers
* text=auto eol=lf

# Shell scripts must have LF endings (CRLF breaks #!/bin/bash shebang)
*.sh text eol=lf

# SQL files
*.sql text eol=lf

# Python
*.py text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Dockerfiles
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
